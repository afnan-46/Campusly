# OPTIONAL. The app runs without this file if MongoDB is on this computer.
# To change a setting, copy this file to .env and edit it.

PORT=5000

# Where MongoDB runs. This is the default for MongoDB installed on your computer.
# In MongoDB Compass you can connect to the same address and see the "campusly" database.
MONGO_URI=mongodb://127.0.0.1:27017/campusly

# Signs login tokens. If left out, a random secret is created and kept in MongoDB.
# JWT_SECRET=put-a-long-random-secret-here
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
APP_TZ=Asia/Dhaka

# Show demo accounts on the sign-in page. Set to false for a real deployment.
DEMO_MODE=true
